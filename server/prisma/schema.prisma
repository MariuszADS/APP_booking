model User {
  id       Int       @id @default(autoincrement())
  email    String    @unique
  name     String

  bookings Booking[]
}

model Service {
  id       Int       @id @default(autoincrement())
  name     String
  comment  String?

  bookings Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())

  userId    Int
  serviceId Int

  date      DateTime
  comment   String?

  user      User     @relation(fields: [userId], references: [id])
  service   Service  @relation(fields: [serviceId], references: [id])
}
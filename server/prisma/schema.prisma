generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // url:process.env("DATABASE_URL")
}

model User{
  id Int @unique @default(autoincrement())
  email String @unique
  name String
}

model Booking{
  id Int @unique @default(autoincrement())
  booked_date String
  appoitment_date String
  comment String?     
}

model Service{
  id Int @unique @default(autoincrement())
  type_service String
  comment String?
}

